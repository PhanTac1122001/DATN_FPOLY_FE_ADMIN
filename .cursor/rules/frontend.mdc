## Anti-Patterns — Never Do

```tsx
// ❌ Hardcoded text
<Button>Lưu</Button>

// ❌ Hardcoded color
<div className="bg-[#BC2228]" />
<Icon color="#64748b" />

// ❌ Inline schema
const schema = z.object({ … });  // in component file

// ❌ Type in component
interface Props { … }  // in component file → src/types/

// ❌ API call in view
const data = await httpClient(…);  // in *-view.tsx

// ❌ Magic status string
if (status === "ACTIVE")  // → use enum/constant

// ❌ Helper function in component file
function formatDate(d: Date) { … }  // → src/utils/

// ❌ Mock data inline in view/component
const courses = [{ id: "1", title: "…" }];  // → src/mocks/courses.mock.ts

// ❌ npm install
npm install foo  // → pnpm add foo
```

