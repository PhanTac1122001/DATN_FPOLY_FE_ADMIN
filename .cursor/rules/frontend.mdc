## Services Pattern

**File:** `src/services/<feature>.service.ts`

```typescript
import { API_ENDPOINTS } from "@/constants/api-endpoints.constants";
import { httpClient } from "@/lib/http-client";
import { HttpMethod } from "@/types/api-types";
import type { Course, CourseListResponse } from "@/types/courses.types";

export async function getCourses(): Promise<CourseListResponse> {
  return httpClient<CourseListResponse>(API_ENDPOINTS.COURSES.LIST, {
    requireAuth: true,
  });
}

export async function createCourse(data: CreateCourseRequest): Promise<Course> {
  return httpClient<Course>(API_ENDPOINTS.COURSES.CREATE, {
    method: HttpMethod.POST,
    body: JSON.stringify(data),
    requireAuth: true,
  });
}
```

- Add endpoints to `API_ENDPOINTS` first — never hardcode URLs
- Use `HttpMethod` enum from `src/types/api-types.ts`
- `requireAuth: false` only for public endpoints (login, register)
- Catch `HttpError` in hooks/components for typed error handling

