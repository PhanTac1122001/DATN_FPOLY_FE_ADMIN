{
    "name": "lms-portal-admin",
    "version": "0.1.0",
    "private": true,
    "packageManager": "pnpm@10.12.1",
    "scripts": {
        "clean": "node -e \"const fs = require('fs'); fs.rmSync('.next', { recursive: true, force: true })\"",
        "dev": "next dev --turbo",
        "dev:clean": "pnpm run clean && pnpm run dev",
        "build": "next build",
        "start": "next start",
        "format": "prettier --write .",
        "lint": "eslint . --fix",
        "lint:check": "eslint . --max-warnings=0",
        "type-check": "tsc --noEmit",
        "duplication-check": "pnpm dlx jscpd ./src -k 15 -r console --ignore \"**/*.d.ts,**/node_modules/**\"",
        "duplication-report": "pnpm dlx jscpd ./src -k 15 -r html --ignore \"**/*.d.ts,**/node_modules/**\"",
        "prepare": "husky"
    },
    "dependencies": {
        "@hookform/resolvers": "^5.2.2",
        "@internationalized/date": "^3.8.2",
        "@marsidev/react-turnstile": "^1.4.1",
        "@microsoft/fetch-event-source": "^2.0.1",
        "@next/third-parties": "^16.2.3",
        "@react-stately/utils": "^3.12.0",
        "@react-types/shared": "^3.32.1",
        "@sentry/nextjs": "^10.36.0",
        "@tanstack/react-query": "^5.90.10",
        "@tanstack/react-query-devtools": "^5.90.2",
        "@tanstack/react-table": "^8.21.3",
        "@tiptap/extension-bubble-menu": "^3.20.0",
        "@tiptap/extension-code-block": "^3.20.0",
        "@tiptap/extension-image": "^3.11.0",
        "@tiptap/extension-link": "^3.11.0",
        "@tiptap/extension-placeholder": "^3.11.0",
        "@tiptap/extension-table": "^3.11.0",
        "@tiptap/extension-table-cell": "^3.11.0",
        "@tiptap/extension-table-header": "^3.11.0",
        "@tiptap/extension-table-row": "^3.11.0",
        "@tiptap/extension-text-align": "^3.11.0",
        "@tiptap/extension-underline": "^3.11.0",
        "@tiptap/pm": "^3.11.0",
        "@tiptap/react": "^3.20.0",
        "@tiptap/starter-kit": "^3.20.0",
        "@untitledui/icons": "^0.0.19",
        "clsx": "^2.1.1",
        "date-fns": "^4.1.0",
        "iconsax-react": "^0.0.8",
        "js-cookie": "^3.0.5",
        "lucide-react": "^0.555.0",
        "mermaid": "^11.15.0",
        "next": "^16.0.3",
        "nextjs-toploader": "^3.9.17",
        "nprogress": "^0.2.0",
        "react": "^19.2.0",
        "react-aria": "^3.44.0",
        "react-aria-components": "^1.13.0",
        "react-dom": "^19.2.0",
        "react-google-recaptcha": "^3.1.0",
        "react-hook-form": "^7.53.0",
        "react-hotkeys-hook": "^5.2.1",
        "react-stately": "^3.42.0",
        "socket.io-client": "^4.8.3",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.4.0",
        "tailwindcss-animate": "^1.0.7",
        "tailwindcss-react-aria-components": "^2.0.1",
        "tiptap-markdown": "^0.9.0",
        "zod": "^4.1.12",
        "zustand": "^5.0.8"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.3",
        "@eslint/js": "^9.39.5",
        "@next/eslint-plugin-next": "^16.0.10",
        "@tailwindcss/postcss": "^4.1.17",
        "@tailwindcss/typography": "^0.5.19",
        "@trivago/prettier-plugin-sort-imports": "^6.0.0",
        "@types/js-cookie": "^3.0.6",
        "@types/node": "^20.12.12",
        "@types/nprogress": "^0.2.3",
        "@types/react": "^19.0.1",
        "@types/react-dom": "^19.0.2",
        "@types/react-google-recaptcha": "^2.1.9",
        "eslint": "^9.39.2",
        "eslint-config-next": "^16.0.10",
        "eslint-plugin-boundaries": "^5.3.1",
        "eslint-plugin-check-file": "^3.3.1",
        "eslint-plugin-i18next": "^6.1.3",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-unused-imports": "^4.3.0",
        "globals": "^17.7.0",
        "husky": "^9.1.7",
        "jscpd": "^4.0.7",
        "jsdom": "^29.1.1",
        "lint-staged": "^16.2.7",
        "postcss": "^8.5.6",
        "prettier": "^3.3.3",
        "prettier-plugin-tailwindcss": "^0.6.9",
        "tailwindcss": "^4.1.17",
        "typescript": "^5.6.3",
        "typescript-eslint": "^8.50.0"
    },
    "lint-staged": {
        "**/*.{ts,tsx,js,jsx}": [
            "eslint --fix --max-warnings=0",
            "prettier --write"
        ],
        "**/*.tsx": [
            "node scripts/check-is-row-header.js"
        ]
    },
    "optionalDependencies": {
        "@next/swc-linux-arm64-gnu": "16.1.4",
        "@next/swc-linux-arm64-musl": "16.1.4",
        "@next/swc-linux-x64-gnu": "16.1.4",
        "@next/swc-linux-x64-musl": "16.1.4",
        "@next/swc-win32-arm64-msvc": "16.1.4",
        "@next/swc-win32-x64-msvc": "16.1.4",
        "@tailwindcss/oxide-linux-x64-gnu": "4.1.18",
        "@tailwindcss/oxide-linux-x64-musl": "4.1.18",
        "@tailwindcss/oxide-win32-x64-msvc": "4.1.18",
        "lightningcss-linux-x64-gnu": "1.30.2",
        "lightningcss-linux-x64-musl": "1.30.2",
        "lightningcss-win32-x64-msvc": "1.30.2"
    }
